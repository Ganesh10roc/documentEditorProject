# ---------------------------------------------------------------------------
# Palimpsest — environment configuration
# Copy to `.env.local` for development. Never commit real secrets.
# ---------------------------------------------------------------------------

# OWNER connection — used for migrations, sign-up, login, and invitee lookups.
# As the table owner it bypasses RLS (which those operations require).
#
#   • Supabase: Project → Connect → "Transaction pooler" (port 6543) for the
#     deployed app; use the "Direct connection" (port 5432) for migrations/seed.
#     Role is `postgres.<project-ref>`. Keep `?sslmode=require`.
#   • Neon / local: a standard postgres:// URL.
DATABASE_URL="postgresql://postgres:password@localhost:5432/palimpsest?sslmode=require"

# APP connection (optional but recommended) — a RESTRICTED, non-owner role used
# for every per-request query, so PostgreSQL Row-Level Security is enforced.
# Create the role with supabase/roles.sql, then point this at it. If unset, the
# app falls back to DATABASE_URL (RLS inert; ORM scoping still isolates tenants).
APP_DATABASE_URL="postgresql://palimpsest_app:password@localhost:5432/palimpsest?sslmode=require"

# Role name granted table access by `npm run db:setup`. Set this to the same
# role used in APP_DATABASE_URL so the grants are applied during setup.
APP_DB_ROLE="palimpsest_app"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Base URL of the deployment (used by Auth.js for callback resolution).
# Locally this is http://localhost:3000; on Vercel it is auto-detected.
AUTH_URL="http://localhost:3000"

# Anthropic API key for AI add-on features (summarise, rewrite, diff explain).
# Optional: the app degrades gracefully and hides AI features if unset.
ANTHROPIC_API_KEY=""

# Maximum accepted size (bytes) of a single sync payload. Hard OOM guard.
# Defaults to 512 KiB if unset.
MAX_SYNC_PAYLOAD_BYTES="524288"

# Real-time collaboration (OPTIONAL). URL of the deployed WebSocket relay
# (realtime-server/, e.g. on Railway). When unset, the app runs on HTTP sync
# alone — no live cursors/presence, but fully functional. Must be wss:// in
# production. The relay itself needs AUTH_SECRET set to the SAME value as above.
NEXT_PUBLIC_WS_URL=""
